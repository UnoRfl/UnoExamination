{
  "name": "unoexamination",
  "version": "1.0.0",
  "description": "Free, serverless, proctored online examination platform (static site + Firebase Auth/Firestore rules).",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-uno \"node --test tests/rules/*.test.js\"",
    "serve": "npx --yes serve -l 5000 .",
    "emulators": "firebase emulators:start",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy": "firebase deploy --only firestore:rules,hosting",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-uno \"node tests/e2e/exam-flow.mjs\"",
    "test:all": "npm test && npm run test:rules && npm run test:e2e"
  },
  "license": "MIT",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.27.0",
    "playwright": "^1.56.1"
  }
}
