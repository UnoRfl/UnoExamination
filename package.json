{
  "name": "unoexamination",
  "version": "1.0.0",
  "description": "Free, serverless, proctored online examination platform (static site + Supabase Postgres/RLS).",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node tests/e2e/exam-flow.mjs",
    "serve": "npx --yes serve -l 5000 .",
    "vendor": "esbuild --bundle --format=esm --platform=browser --target=es2020 --minify --alias:ws=./build/ws-shim.js --alias:@supabase/node-fetch=./build/node-fetch-shim.js --outfile=js/vendor/supabase-js.js node_modules/@supabase/supabase-js/dist/module/index.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.1"
  }
}
